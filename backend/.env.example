# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Either provide a full connection URL or individual connection parameters:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety_db
# Or:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sweety_db

# Authentication
JWT_SECRET=super_secret_sweety_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

